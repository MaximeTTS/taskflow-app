# Copier ce fichier en `.env` et renseigner chaque valeur.
# L'application refuse de démarrer si une variable obligatoire manque :
# un secret absent ne doit jamais dégrader silencieusement la sécurité.

# ── Obligatoire ───────────────────────────────────────────────────────────────

# Chaîne de connexion PostgreSQL.
DATABASE_URL="postgresql://utilisateur:motdepasse@hote:5432/taskflow?schema=public"

# Secret de signature des jetons JWT. 32 caractères minimum.
# Générer une valeur :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# ── Optionnel : envoi d'images ────────────────────────────────────────────────
# Sans ces trois valeurs, les avatars et les images de tâches ne peuvent pas
# être envoyés. Disponibles sur le tableau de bord Cloudinary.

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
